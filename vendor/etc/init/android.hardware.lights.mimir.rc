service vendor.light /vendor/bin/hw/android.hardware.lights-service.mimir
    class hal
    user system
    group system
    shutdown critical

on boot
    # Change ownership and permission for leds backlight
    chown system system /sys/class/leds/lcd-backlight/brightness
    chmod 0664 /sys/class/leds/lcd-backlight/brightness
    chown system system /sys/class/leds/lcd-backlight/max_brightness
    chmod 0664 /sys/class/leds/lcd-backlight/max_brightness
    chown system system /sys/class/leds/red/brightness
    chmod 0664 /sys/class/leds/red/brightness
    chown system system /sys/class/leds/red/max_brightness
    chmod 0664 /sys/class/leds/red/max_brightness
    chown system system /sys/class/leds/green/brightness
    chmod 0664 /sys/class/leds/green/brightness
    chown system system /sys/class/leds/green/max_brightness
    chmod 0664 /sys/class/leds/green/max_brightness
    chown system system /sys/class/leds/blue/brightness
    chmod 0664 /sys/class/leds/blue/brightness
    chown system system /sys/class/leds/blue/max_brightness
    chmod 0664 /sys/class/leds/blue/max_brightness
